<%- include('partials/header') %>

<!-- BANNER -->
<section class="page-banner">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><i class="fa-solid fa-house me-1"></i>Trang Chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Liên Hệ</li>
      </ol>
    </nav>
    <span class="badge bg-primary px-3 py-2 mb-2"><%= contact.heroBadge %></span>
    <h1><%= contact.heroTitle %></h1>
    <p><%= contact.heroSubtitle %></p>
  </div>
</section>

<!-- Success Alert -->
<% if (typeof success !== 'undefined' && success === 'sent') { %>
  <div class="alert alert-success alert-dismissible fade show container mt-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i><strong>Gửi liên hệ thành công!</strong> Cảm ơn bạn đã liên hệ với TechVision. Chuyên viên chăm sóc khách hàng của chúng tôi sẽ phản hồi lại bạn sớm nhất có thể.
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- MAIN CONTENT -->
<section class="py-5" id="contact-form">
  <div class="container">
    <div class="row g-5">
      <!-- CỘT FORM LIÊN HỆ (7 COLS) -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white border">
          <h3 class="fw-bold mb-2"><%= contact.formTitle %></h3>
          <p class="text-secondary small mb-4"><%= contact.formSubtitle %></p>

          <form action="/lien-he" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Họ và tên của bạn *</label>
                <input type="text" name="name" class="form-control" placeholder="Nguyễn Văn A" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Số điện thoại *</label>
                <input type="tel" name="phone" class="form-control" placeholder="0988xxxxxx" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Địa chỉ Email *</label>
                <input type="email" name="email" class="form-control" placeholder="email@domain.com" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Dịch vụ quan tâm</label>
                <select name="service" class="form-select">
                  <option value="Tư vấn chung">Tư vấn chung</option>
                  <% if (navServices && navServices.length) { %>
                    <% navServices.forEach(function(s) { %>
                      <option value="<%= s.title %>"><%= s.title %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label">Tiêu đề liên hệ</label>
                <input type="text" name="subject" class="form-control" placeholder="VD: Yêu cầu báo giá thiết kế website">
              </div>
              <div class="col-12">
                <label class="form-label">Nội dung tin nhắn *</label>
                <textarea name="message" class="form-control" rows="4" placeholder="Vui lòng chia sẻ cụ thể yêu cầu của bạn..." required></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold">
                  <i class="fa-solid fa-paper-plane me-2"></i>Gửi Thông Điệp Của Bạn
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- CỘT THÔNG TIN LIÊN HỆ & BẢN ĐỒ (5 COLS) -->
      <div class="col-lg-5">
        <h4 class="fw-bold mb-4"><%= contact.infoTitle %></h4>

        <div class="contact-info-card">
          <div class="contact-info-icon">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Trụ sở chính</h6>
            <p class="text-secondary small mb-0"><%= settings.address %></p>
          </div>
        </div>

        <% if (settings.branchAddress) { %>
          <div class="contact-info-card">
            <div class="contact-info-icon">
              <i class="fa-solid fa-building"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-1">Chi nhánh phía Nam</h6>
              <p class="text-secondary small mb-0"><%= settings.branchAddress %></p>
            </div>
          </div>
        <% } %>

        <div class="contact-info-card">
          <div class="contact-info-icon">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Đường dây nóng</h6>
            <p class="text-secondary small mb-0">Hotline: <strong class="text-primary"><%= settings.hotline %></strong></p>
            <p class="text-secondary small mb-0">Hỗ trợ kỹ thuật: <%= settings.phone %></p>
          </div>
        </div>

        <div class="contact-info-card">
          <div class="contact-info-icon">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Hộp thư điện tử</h6>
            <p class="text-secondary small mb-0"><%= settings.email %></p>
          </div>
        </div>

        <div class="contact-info-card">
          <div class="contact-info-icon">
            <i class="fa-regular fa-clock"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Thời gian làm việc</h6>
            <p class="text-secondary small mb-0"><%= settings.workingHours %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- GOOGLE MAP IFRAME -->
    <div class="mt-5 pt-3">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden border">
        <div class="card-header bg-light py-3 px-4 border-bottom">
          <h5 class="fw-bold mb-0"><i class="fa-solid fa-map-location-dot text-primary me-2"></i>Bản Đồ Chỉ Đường Trụ Sở TechVision</h5>
        </div>
        <div class="ratio ratio-21x9" style="min-height: 400px;">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3723.8639850444997!2d105.7892672!3d21.0381278!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab3b4220da11%3A0xe100a404ced50259!2zQ-G6p3UgR2nhuqV5LCBIw6AgTuG7mWksIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1700000000000!5m2!1svi!2s" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

