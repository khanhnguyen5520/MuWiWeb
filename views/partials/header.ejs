<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle ? pageTitle + ' - ' + settings.siteName : settings.siteName %></title>
  <meta name="description" content="<%= settings.metaDesc || '' %>">
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Announcement Bar -->
  <div class="bg-dark text-white py-2 small d-none d-md-block" style="background-color: #0b1120 !important;">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-4">
        <span><i class="fa-solid fa-phone text-primary me-2"></i>Hotline: <strong><%= settings.hotline %></strong></span>
        <span><i class="fa-solid fa-envelope text-primary me-2"></i>Email: <%= settings.email %></span>
      </div>
      <div class="d-flex align-items-center gap-3">
        <span><i class="fa-regular fa-clock text-primary me-1"></i><%= settings.workingHours %></span>
        <% if (currentUser) { %>
          <a href="/admin" class="badge bg-primary text-white text-decoration-none px-2 py-1">
            <i class="fa-solid fa-gauge me-1"></i>Vào Admin
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/">
        <% if (settings.logoUrl) { %>
          <img src="<%= settings.logoUrl %>" alt="<%= settings.siteName %>" height="42">
        <% } else { %>
          <div class="brand-icon"><i class="fa-solid fa-cube"></i></div>
          <span><%= settings.logoText || settings.siteName %></span>
        <% } %>
      </a>

      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/">
              <i class="fa-solid fa-house me-1"></i>Trang Chủ
            </a>
          </li>

          <!-- Dịch vụ Dropdown với 5 trang nhỏ -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= path.startsWith('/dich-vu') ? 'active' : '' %>" href="/dich-vu" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-cubes me-1"></i>Dịch Vụ
            </a>
            <ul class="dropdown-menu shadow border-0" aria-labelledby="servicesDropdown">
              <li>
                <a class="dropdown-item fw-bold text-primary" href="/dich-vu">
                  <i class="fa-solid fa-arrow-right"></i> Xem tất cả dịch vụ
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <% if (typeof navServices !== 'undefined' && navServices.length > 0) { %>
                <% navServices.forEach(function(s) { %>
                  <li>
                    <a class="dropdown-item <%= path === '/dich-vu/' + s.slug ? 'active text-primary' : '' %>" href="/dich-vu/<%= s.slug %>">
                      <i class="fa-solid <%= s.icon || 'fa-check' %>"></i>
                      <span><%= s.title %></span>
                    </a>
                  </li>
                <% }); %>
              <% } %>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= path.startsWith('/tuyen-dung') ? 'active' : '' %>" href="/tuyen-dung">
              <i class="fa-solid fa-users-line me-1"></i>Tuyển Dụng
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= path === '/lien-he' ? 'active' : '' %>" href="/lien-he">
              <i class="fa-solid fa-headset me-1"></i>Liên Hệ
            </a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2">
          <a href="/lien-he#tu-van" class="btn btn-primary d-none d-sm-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Nhận Báo Giá</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

