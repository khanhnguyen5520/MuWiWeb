  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="row g-4">
        <!-- Col 1: About & Info -->
        <div class="col-lg-4 col-md-6">
          <div class="footer-brand">
            <% if (settings.logoUrl) { %>
              <img src="<%= settings.logoUrl %>" alt="<%= settings.siteName %>" height="38">
            <% } else { %>
              <div class="brand-icon"><i class="fa-solid fa-cube"></i></div>
              <span><%= settings.logoText || settings.siteName %></span>
            <% } %>
          </div>
          <p class="text-secondary mb-4"><%= settings.slogan %></p>
          <div class="d-flex flex-column gap-2 text-secondary small">
            <div><i class="fa-solid fa-location-dot text-primary me-2"></i><%= settings.address %></div>
            <% if (settings.branchAddress) { %>
              <div><i class="fa-solid fa-building text-primary me-2"></i>CN: <%= settings.branchAddress %></div>
            <% } %>
            <div><i class="fa-solid fa-phone text-primary me-2"></i>Hotline: <%= settings.hotline %> - <%= settings.phone %></div>
            <div><i class="fa-solid fa-envelope text-primary me-2"></i>Email: <%= settings.email %></div>
          </div>
          <div class="social-links">
            <% if (settings.facebook) { %><a href="<%= settings.facebook %>" target="_blank" class="social-link" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a><% } %>
            <% if (settings.linkedin) { %><a href="<%= settings.linkedin %>" target="_blank" class="social-link" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a><% } %>
            <% if (settings.youtube) { %><a href="<%= settings.youtube %>" target="_blank" class="social-link" title="YouTube"><i class="fa-brands fa-youtube"></i></a><% } %>
            <% if (settings.zalo) { %><a href="<%= settings.zalo %>" target="_blank" class="social-link" title="Zalo"><i class="fa-solid fa-comment-dots"></i></a><% } %>
          </div>
        </div>

        <!-- Col 2: Dịch vụ của chúng tôi (5 dịch vụ con) -->
        <div class="col-lg-3 col-md-6">
          <h5 class="footer-heading">5 Dịch Vụ Chủ Lực</h5>
          <ul class="footer-links">
            <% if (typeof navServices !== 'undefined' && navServices.length > 0) { %>
              <% navServices.forEach(function(s) { %>
                <li>
                  <a href="/dich-vu/<%= s.slug %>">
                    <i class="fa-solid fa-angle-right text-primary"></i>
                    <span><%= s.title %></span>
                  </a>
                </li>
              <% }); %>
            <% } %>
          </ul>
        </div>

        <!-- Col 3: Liên kết nhanh -->
        <div class="col-lg-2 col-md-6">
          <h5 class="footer-heading">Liên Kết Nhanh</h5>
          <ul class="footer-links">
            <li><a href="/"><i class="fa-solid fa-angle-right text-primary"></i> Trang Chủ</a></li>
            <li><a href="/dich-vu"><i class="fa-solid fa-angle-right text-primary"></i> Tổng Quan Dịch Vụ</a></li>
            <li><a href="/tuyen-dung"><i class="fa-solid fa-angle-right text-primary"></i> Cơ Hội Việc Làm</a></li>
            <li><a href="/lien-he"><i class="fa-solid fa-angle-right text-primary"></i> Liên Hệ Trực Tuyến</a></li>
            <li><a href="/admin"><i class="fa-solid fa-shield-halved text-primary"></i> Trang Quản Trị</a></li>
          </ul>
        </div>

        <!-- Col 4: Nhận tư vấn nhanh -->
        <div class="col-lg-3 col-md-6">
          <h5 class="footer-heading">Đăng Ký Tư Vấn</h5>
          <p class="text-secondary small mb-3">Nhập số điện thoại để chuyên viên tư vấn của TechVision gọi lại cho bạn:</p>
          <form action="/gui-tu-van" method="POST">
            <div class="mb-2">
              <input type="text" name="name" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Họ và tên của bạn" required>
            </div>
            <div class="mb-2">
              <input type="tel" name="phone" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Số điện thoại của bạn" required>
            </div>
            <button type="submit" class="btn btn-primary btn-sm w-100">
              <i class="fa-solid fa-paper-plane me-1"></i> Gửi Ngay
            </button>
          </form>
        </div>
      </div>

      <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div><%= settings.copyrightText %></div>
        <div class="d-flex gap-3">
          <a href="/admin" class="text-secondary small hover-primary"><i class="fa-solid fa-lock me-1"></i>Admin Portal</a>
          <a href="#top" class="text-secondary small hover-primary"><i class="fa-solid fa-arrow-up me-1"></i>Lên Đầu Trang</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Main JS -->
  <script src="/js/main.js"></script>
</body>
</html>

