<%- include('partials/header') %>

<!-- BANNER -->
<section class="page-banner">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><i class="fa-solid fa-house me-1"></i>Trang Chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Dịch Vụ</li>
      </ol>
    </nav>
    <h1>Hệ Thống Dịch Vụ & Giải Pháp Công Nghệ</h1>
    <p>TechVision tự hào mang đến 5 nhóm dịch vụ chuyên sâu với quy trình chuẩn hóa quốc tế, đáp ứng toàn diện mọi nhu cầu số hóa của doanh nghiệp.</p>
  </div>
</section>

<!-- MAIN CONTENT -->
<section class="py-5">
  <div class="container">
    <div class="section-header text-center mb-5">
      <span class="badge-soft">Danh Sách Dịch Vụ</span>
      <h2 class="section-title">Khám Phá Chi Tiết 5 Dịch Vụ Chủ Lực</h2>
      <p class="section-subtitle">Lựa chọn giải pháp phù hợp để tăng tốc chuyển đổi số và nâng tầm thương hiệu doanh nghiệp bạn.</p>
    </div>

    <div class="row g-4">
      <% if (services && services.length) { %>
        <% services.forEach(function(s, index) { %>
          <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden service-card-detailed p-3 bg-white border">
              <div class="row g-0 align-items-center">
                <div class="col-md-5">
                  <div class="position-relative h-100" style="min-height: 220px;">
                    <img src="<%= s.image %>" class="img-fluid rounded-3 w-100 h-100 object-fit-cover" alt="<%= s.title %>">
                    <div class="position-absolute top-0 start-0 m-2">
                      <span class="badge bg-primary px-3 py-2 fw-semibold">Dịch vụ #0<%= index + 1 %></span>
                    </div>
                  </div>
                </div>
                <div class="col-md-7">
                  <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-semibold">
                      <i class="fa-solid <%= s.icon || 'fa-cube' %> fa-lg"></i>
                      <span><%= s.priceNote || 'Tư vấn giải pháp' %></span>
                    </div>
                    <h3 class="card-title fs-5 fw-bold mb-2">
                      <a href="/dich-vu/<%= s.slug %>" class="text-dark hover-primary"><%= s.title %></a>
                    </h3>
                    <p class="card-text text-secondary small mb-3"><%= s.shortDesc %></p>

                    <!-- Features bullets -->
                    <% if (s.features && s.features.length) { %>
                      <ul class="list-unstyled small mb-3">
                        <% s.features.slice(0, 3).forEach(function(f) { %>
                          <li class="mb-1 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-check text-success"></i>
                            <span class="text-truncate"><%= f %></span>
                          </li>
                        <% }); %>
                      </ul>
                    <% } %>

                    <a href="/dich-vu/<%= s.slug %>" class="btn btn-sm btn-primary">
                      Xem Chi Tiết Dịch Vụ <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <p class="text-muted">Chưa có dịch vụ nào được cấu hình.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- CAM KẾT CHẤT LƯỢNG -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-6">
        <span class="badge-soft mb-2">Cam Kết Của Chúng Tôi</span>
        <h2 class="section-title">Tiêu Chuẩn Dịch Vụ Khắt Khe & Minh Bạch</h2>
        <p class="text-secondary mt-3">Chúng tôi đặt chữ TÍN và sự hài lòng của khách hàng lên hàng đầu. Mỗi sản phẩm bàn giao đều trải qua quy trình kiểm thử nghiêm ngặt theo các chuẩn công nghệ cao nhất.</p>
        <div class="row g-3 mt-2">
          <div class="col-sm-6">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-circle-check text-primary fs-5"></i>
              <span class="fw-semibold">Bàn giao đúng hạn</span>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-circle-check text-primary fs-5"></i>
              <span class="fw-semibold">Hợp đồng rõ ràng</span>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-circle-check text-primary fs-5"></i>
              <span class="fw-semibold">Bảo mật thông tin</span>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-circle-check text-primary fs-5"></i>
              <span class="fw-semibold">Hỗ trợ 24/7/365</span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-6 text-center">
        <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm border">
          <h4 class="fw-bold mb-3">Bạn Chưa Biết Chọn Gói Dịch Vụ Nào?</h4>
          <p class="text-secondary small mb-4">Hãy để đội ngũ chuyên gia của chúng tôi tư vấn miễn phí giải pháp tối ưu nhất cho bài toán của doanh nghiệp bạn.</p>
          <a href="/lien-he" class="btn btn-primary btn-lg w-100">
            <i class="fa-solid fa-headset me-2"></i>Liên Hệ Tư Vấn Ngay
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

