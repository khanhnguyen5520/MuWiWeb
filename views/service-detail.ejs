<%- include('partials/header') %>

<!-- BANNER -->
<section class="page-banner">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><i class="fa-solid fa-house me-1"></i>Trang Chủ</a></li>
        <li class="breadcrumb-item"><a href="/dich-vu">Dịch Vụ</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= service.title %></li>
      </ol>
    </nav>
    <div class="d-flex align-items-center gap-3">
      <div class="service-icon-banner p-3 bg-white text-primary rounded-3 shadow-sm fs-2 d-none d-sm-block">
        <i class="fa-solid <%= service.icon || 'fa-cube' %>"></i>
      </div>
      <div>
        <h1><%= service.title %></h1>
        <p class="mb-0 text-light"><%= service.shortDesc %></p>
      </div>
    </div>
  </div>
</section>

<!-- MAIN CONTENT -->
<section class="py-5">
  <div class="container">
    <div class="row g-4">
      
      <!-- CỘT NỘI DUNG CHÍNH (8 COLS) -->
      <div class="col-lg-8">
        <div class="service-content-card">
          <!-- Ảnh đại diện dịch vụ -->
          <div class="mb-4 rounded-3 overflow-hidden border">
            <img src="<%= service.image %>" alt="<%= service.title %>" class="img-fluid w-100 object-fit-cover" style="max-height: 420px;">
          </div>

          <!-- Price & Summary Alert -->
          <div class="alert alert-primary d-flex align-items-center justify-content-between p-3 rounded-3 mb-4">
            <div>
              <span class="small text-muted d-block">Mức chi phí tham khảo:</span>
              <strong class="fs-5 text-primary"><%= service.priceNote || 'Tùy biến theo yêu cầu' %></strong>
            </div>
            <a href="#service-inquiry" class="btn btn-sm btn-primary">
              <i class="fa-solid fa-paper-plane me-1"></i> Nhận Báo Giá
            </a>
          </div>

          <!-- Danh sách tính năng / cam kết nổi bật -->
          <% if (service.features && service.features.length) { %>
            <div class="bg-light p-4 rounded-3 border mb-4">
              <h4 class="fs-5 fw-bold mb-3 text-dark">
                <i class="fa-solid fa-circle-check text-success me-2"></i>Tính Năng & Ưu Thế Nổi Bật:
              </h4>
              <div class="row g-2">
                <% service.features.forEach(function(feat) { %>
                  <div class="col-md-6">
                    <div class="d-flex align-items-start gap-2">
                      <i class="fa-solid fa-check-circle text-primary mt-1"></i>
                      <span class="text-secondary small fw-medium"><%= feat %></span>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Nội dung chi tiết phong phú (HTML từ CMS) -->
          <div class="service-article">
            <%- service.contentHtml %>
          </div>

          <!-- Form đăng ký tư vấn riêng cho dịch vụ này -->
          <div class="mt-5 pt-4 border-top" id="service-inquiry">
            <div class="p-4 bg-light rounded-4 border">
              <h4 class="fw-bold fs-5 mb-2">Đăng Ký Tư Vấn Dịch Vụ Này</h4>
              <p class="text-secondary small mb-3">Chuyên gia của TechVision sẽ phân tích nhu cầu và chuẩn bị phương án triển khai dành riêng cho bạn:</p>

              <form action="/gui-tu-van" method="POST">
                <input type="hidden" name="service" value="<%= service.title %>">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold">Họ và tên của bạn *</label>
                    <input type="text" name="name" class="form-control" placeholder="Nguyễn Văn A" required>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold">Số điện thoại liên hệ *</label>
                    <input type="tel" name="phone" class="form-control" placeholder="0988xxxxxx" required>
                  </div>
                  <div class="col-12">
                    <label class="form-label small fw-semibold">Địa chỉ Email</label>
                    <input type="email" name="email" class="form-control" placeholder="email@domain.com">
                  </div>
                  <div class="col-12">
                    <label class="form-label small fw-semibold">Chi tiết yêu cầu hoặc câu hỏi</label>
                    <textarea name="message" class="form-control" rows="3" placeholder="Mô tả ngắn gọn về quy mô hoặc mục tiêu của bạn..."></textarea>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                      <i class="fa-solid fa-paper-plane me-1"></i> Gửi Yêu Cầu Tư Vấn Ngay
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>

        </div>
      </div>

      <!-- CỘT SIDEBAR (4 COLS) -->
      <div class="col-lg-4">
        <!-- 1. Danh sách các dịch vụ khác (5 dịch vụ con) -->
        <div class="service-sidebar-card">
          <h5 class="fw-bold mb-3">
            <i class="fa-solid fa-cubes text-primary me-2"></i>Dịch Vụ Liên Quan
          </h5>
          <div class="service-sub-nav list-group list-group-flush">
            <a href="/dich-vu/<%= service.slug %>" class="list-group-item active">
              <span><i class="fa-solid <%= service.icon || 'fa-cube' %> me-2"></i><%= service.title %></span>
              <i class="fa-solid fa-chevron-right small"></i>
            </a>
            <% if (otherServices && otherServices.length) { %>
              <% otherServices.forEach(function(item) { %>
                <a href="/dich-vu/<%= item.slug %>" class="list-group-item">
                  <span><i class="fa-solid <%= item.icon || 'fa-cube' %> me-2 text-primary"></i><%= item.title %></span>
                  <i class="fa-solid fa-chevron-right small text-muted"></i>
                </a>
              <% }); %>
            <% } %>
          </div>
        </div>

        <!-- 2. Box Hỗ Trợ Trực Tuyến -->
        <div class="service-sidebar-card bg-primary text-white">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="fs-1 text-white opacity-75">
              <i class="fa-solid fa-headset"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0 text-white">Cần Tư Vấn Gấp?</h5>
              <small class="text-white-50">Hỗ trợ kỹ thuật 24/7</small>
            </div>
          </div>
          <p class="small text-white-50 mb-3">Gọi ngay tổng đài để gặp trực tiếp chuyên gia tư vấn giải pháp:</p>
          <div class="bg-white text-dark p-3 rounded-3 text-center mb-3">
            <span class="small text-muted d-block">Hotline Hỗ Trợ 24/7</span>
            <strong class="fs-4 text-primary"><%= settings.hotline %></strong>
          </div>
          <a href="/lien-he" class="btn btn-outline-light w-100 fw-semibold">
            <i class="fa-solid fa-envelope me-1"></i> Trang Liên Hệ
          </a>
        </div>

        <!-- 3. Cam kết doanh nghiệp -->
        <div class="service-sidebar-card">
          <h5 class="fw-bold mb-3">Cam Kết Dịch Vụ</h5>
          <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
            <li><i class="fa-solid fa-shield-halved text-primary me-2"></i>Bảo mật dữ liệu 100% theo chuẩn ISO</li>
            <li><i class="fa-solid fa-file-contract text-primary me-2"></i>Hợp đồng pháp lý minh bạch, rõ ràng</li>
            <li><i class="fa-solid fa-clock text-primary me-2"></i>Bàn giao đúng tiến độ cam kết</li>
            <li><i class="fa-solid fa-wrench text-primary me-2"></i>Hỗ trợ kỹ thuật & bảo hành trọn đời</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>

