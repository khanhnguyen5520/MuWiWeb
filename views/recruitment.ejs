<%- include('partials/header') %>

<!-- BANNER -->
<section class="page-banner">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><i class="fa-solid fa-house me-1"></i>Trang Chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Tuyển Dụng</li>
      </ol>
    </nav>
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="badge bg-primary px-3 py-2 mb-2"><%= recruitment.heroBadge %></span>
        <h1><%= recruitment.heroTitle %></h1>
        <p><%= recruitment.heroSubtitle %></p>
        <a href="#danh-sach-viec-lam" class="btn btn-outline-light btn-sm mt-2">
          <i class="fa-solid fa-arrow-down me-1"></i> Xem Các Vị Trí Đang Tuyển (<%= jobs ? jobs.length : 0 %>)
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Success Alert -->
<% if (typeof success !== 'undefined' && success === 'applied') { %>
  <div class="alert alert-success alert-dismissible fade show container mt-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i><strong>Nộp hồ sơ thành công!</strong> Cảm ơn bạn đã quan tâm. Bộ phận nhân sự của TechVision sẽ liên hệ lại qua email hoặc số điện thoại trong thời gian sớm nhất!
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- VĂN HÓA & ĐÃI NGỘ -->
<section class="py-5">
  <div class="container">
    <div class="section-header text-center mb-5">
      <span class="badge-soft">Môi Trường Làm Việc</span>
      <h2 class="section-title"><%= recruitment.cultureTitle %></h2>
      <p class="section-subtitle"><%= recruitment.cultureDesc %></p>
    </div>

    <div class="row g-4">
      <% if (recruitment.perks && recruitment.perks.length) { %>
        <% recruitment.perks.forEach(function(perk) { %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center border">
              <div class="why-icon mx-auto mb-3">
                <i class="fa-solid <%= perk.icon || 'fa-gift' %>"></i>
              </div>
              <h4 class="fs-5 fw-bold mb-2"><%= perk.title %></h4>
              <p class="text-secondary small mb-0"><%= perk.desc %></p>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<!-- DANH SÁCH VIỆC LÀM -->
<section class="py-5 bg-light" id="danh-sach-viec-lam">
  <div class="container">
    <div class="section-header text-center mb-5">
      <span class="badge-soft">Vị Trí Đang Tuyển Dụng</span>
      <h2 class="section-title">Khám Phá Các Cơ Hội Việc Làm Hấp Dẫn</h2>
      <p class="section-subtitle">Hãy gia nhập đội ngũ những người dẫn đầu công nghệ số và cùng nhau chinh phục những đỉnh cao mới.</p>
    </div>

    <div class="row g-4">
      <% if (jobs && jobs.length > 0) { %>
        <% jobs.forEach(function(job) { %>
          <div class="col-lg-6">
            <div class="job-card bg-white h-100 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-primary text-white"><%= job.department %></span>
                <span class="text-muted small"><i class="fa-regular fa-calendar-check me-1"></i>Hạn nộp: <%= job.deadline || 'Thường xuyên' %></span>
              </div>
              <h3 class="job-title">
                <a href="/tuyen-dung/<%= job.id %>" class="text-dark hover-primary"><%= job.title %></a>
              </h3>
              
              <div class="job-tags my-2">
                <span class="job-tag"><i class="fa-solid fa-location-dot"></i> <%= job.location %></span>
                <span class="job-tag text-success fw-bold"><i class="fa-solid fa-sack-dollar"></i> <%= job.salary %></span>
                <span class="job-tag"><i class="fa-solid fa-briefcase"></i> <%= job.type || 'Toàn thời gian' %></span>
                <span class="job-tag"><i class="fa-solid fa-user-clock"></i> <%= job.experience %></span>
              </div>

              <p class="text-secondary small mb-3 flex-grow-1"><%= job.description %></p>

              <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                <a href="/tuyen-dung/<%= job.id %>" class="btn btn-outline-primary btn-sm">
                  Xem Yêu Cầu Chi Tiết <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
                <a href="/tuyen-dung/<%= job.id %>#apply" class="btn btn-primary btn-sm">
                  Nộp CV Ngay
                </a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <p class="text-muted">Hiện tại công ty chưa có đợt tuyển dụng mới. Vui lòng quay lại sau!</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- FORM ỨNG TUYỂN TRỰC TIẾP -->
<section class="py-5" id="apply-form">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white border">
          <div class="text-center mb-4">
            <span class="badge-soft mb-2">Gửi Hồ Sơ Ứng Tuyển</span>
            <h3 class="fw-bold">Nộp CV Trực Tuyến</h3>
            <p class="text-secondary small">Nếu bạn chưa tìm thấy vị trí phù hợp, đừng ngần ngại gửi CV để chúng tôi lưu trữ hồ sơ cho các cơ hội tiếp theo!</p>
          </div>

          <form action="/tuyen-dung/ung-tuyen" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Họ và tên của bạn *</label>
                <input type="text" name="fullName" class="form-control" placeholder="Nguyễn Văn A" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Số điện thoại liên hệ *</label>
                <input type="tel" name="phone" class="form-control" placeholder="0988xxxxxx" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Địa chỉ Email *</label>
                <input type="email" name="email" class="form-control" placeholder="email@gmail.com" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Vị trí ứng tuyển *</label>
                <select name="jobTitle" class="form-select" required>
                  <option value="">-- Chọn vị trí quan tâm --</option>
                  <% if (jobs && jobs.length > 0) { %>
                    <% jobs.forEach(function(j) { %>
                      <option value="<%= j.title %>"><%= j.title %></option>
                    <% }); %>
                  <% } %>
                  <option value="Ứng tuyển vị trí khác / Tự do">Vị trí khác / Ứng tuyển dự phòng</option>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label">Đính kèm tệp CV (PDF / DOC / DOCX, tối đa 10MB) *</label>
                <input type="file" name="cv" class="form-control" accept=".pdf,.doc,.docx" required>
              </div>
              <div class="col-12">
                <label class="form-label">Đôi lời giới thiệu về bạn hoặc link Portfolio / LinkedIn</label>
                <textarea name="note" class="form-control" rows="3" placeholder="Giới thiệu kỹ năng nổi bật, link Github, Behance hoặc lý do bạn muốn làm việc tại TechVision..."></textarea>
              </div>
              <div class="col-12 text-center mt-4">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                  <i class="fa-solid fa-paper-plane me-2"></i>Nộp Hồ Sơ Ứng Tuyển
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

