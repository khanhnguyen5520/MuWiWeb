<%- include('../partials/admin-header') %>
<%- include('../partials/admin-sidebar') %>

<% if (typeof success !== 'undefined' && success === 'saved') { %>
  <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
    <i class="fa-solid fa-circle-check fs-5"></i>
    <div><strong>Lưu thành công!</strong> Nội dung Trang Tuyển Dụng đã được cập nhật.</div>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<form action="/admin/pages/recruitment" method="POST" enctype="multipart/form-data">

  <!-- Banner Tuyển dụng -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title"><i class="fa-solid fa-user-plus text-primary me-2"></i>Banner Đầu Trang Tuyển Dụng</h3>
    </div>
    <div class="admin-card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Huy hiệu</label>
          <input type="text" name="heroBadge" class="form-control" value="<%= recruitment.heroBadge %>">
        </div>
        <div class="col-md-8">
          <label class="form-label">Tiêu đề chính</label>
          <input type="text" name="heroTitle" class="form-control" value="<%= recruitment.heroTitle %>" required>
        </div>
        <div class="col-12">
          <label class="form-label">Phụ đề mô tả</label>
          <textarea name="heroSubtitle" class="form-control" rows="2"><%= recruitment.heroSubtitle %></textarea>
        </div>
        <div class="col-md-8">
          <label class="form-label">URL Ảnh nền / Banner</label>
          <input type="text" name="heroImageUrl" class="form-control" value="<%= recruitment.heroImage %>">
          <div class="mt-2">
            <input type="file" name="heroImage" class="form-control form-control-sm" accept="image/*" data-preview="recHeroPreview">
          </div>
        </div>
        <div class="col-md-4 text-center">
          <label class="form-label d-block">Xem trước</label>
          <img id="recHeroPreview" src="<%= recruitment.heroImage %>" alt="Preview" class="rounded border shadow-sm" style="max-height: 100px; max-width: 100%;">
        </div>
      </div>
    </div>
  </div>

  <!-- Văn hóa & Đãi ngộ -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title"><i class="fa-solid fa-hand-holding-heart text-primary me-2"></i>Văn Hóa Làm Việc & Chế Độ Đãi Ngộ</h3>
    </div>
    <div class="admin-card-body">
      <div class="row g-3 mb-4">
        <div class="col-12">
          <label class="form-label">Tiêu đề khối văn hóa</label>
          <input type="text" name="cultureTitle" class="form-control" value="<%= recruitment.cultureTitle %>">
        </div>
        <div class="col-12">
          <label class="form-label">Mô tả tổng quan</label>
          <textarea name="cultureDesc" class="form-control" rows="2"><%= recruitment.cultureDesc %></textarea>
        </div>
      </div>

      <h5 class="fw-bold mb-3">Các Đãi Ngộ / Phúc Lợi Nổi Bật:</h5>
      <% if (recruitment.perks && recruitment.perks.length) { %>
        <% recruitment.perks.forEach(function(p, idx) { %>
          <div class="repeatable-item">
            <div class="row g-2">
              <div class="col-md-3">
                <label class="form-label">Icon FontAwesome</label>
                <input type="text" name="perkIcon" class="form-control" value="<%= p.icon %>">
              </div>
              <div class="col-md-4">
                <label class="form-label">Tiêu đề phúc lợi <%= idx + 1 %></label>
                <input type="text" name="perkTitle" class="form-control" value="<%= p.title %>">
              </div>
              <div class="col-md-5">
                <label class="form-label">Mô tả phúc lợi</label>
                <input type="text" name="perkDesc" class="form-control" value="<%= p.desc %>">
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <div class="text-end mb-4">
    <button type="submit" class="btn btn-primary px-4 fw-bold">
      <i class="fa-solid fa-floppy-disk me-2"></i>Lưu Nội Dung Tuyển Dụng
    </button>
  </div>

</form>

<%- include('../partials/admin-footer') %>

