<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng Nhập Quản Trị Hệ Thống - <%= settings.siteName %>
  </title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-card {
      background: #ffffff;
      border-radius: 20px;
      padding: 40px;
      width: 100%;
      max-width: 440px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .brand-icon-big {
      width: 56px;
      height: 56px;
      background: linear-gradient(135deg, #2563eb, #6366f1);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      font-size: 1.8rem;
      margin: 0 auto 16px;
      box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
    }
  </style>
</head>

<body>

  <div class="login-card">
    <div class="text-center mb-4">
      <div class="brand-icon-big">
        <i class="fa-solid fa-cube"></i>
      </div>
      <h3 class="fw-bold mb-1">Quản Trị Hệ Thống</h3>
      <p class="text-muted small">
        <%= settings.siteName %>
      </p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Tên đăng nhập hoặc mật khẩu không chính xác!</span>
      </div>
      <% } %>

        <form action="/admin/login" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">Tên đăng nhập</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
              <input type="text" name="username" class="form-control" placeholder="Tên tài khoản (mặc định: admin)"
                required autofocus>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Mật khẩu</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
              <input type="password" name="password" class="form-control" placeholder="Mật khẩu (mặc định: admin123)"
                required>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold fs-6 mb-3 shadow">
            <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng Nhập
          </button>

          <div class="text-center mt-3">
            <a href="/" class="small text-decoration-none text-muted hover-primary">
              <i class="fa-solid fa-arrow-left me-1"></i> Quay lại website
            </a>
          </div>
        </form>
  </div>

</body>

</html>