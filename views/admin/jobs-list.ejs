<%- include('../partials/admin-header') %>
<%- include('../partials/admin-sidebar') %>

<% if (typeof success !== 'undefined') { %>
  <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
    <i class="fa-solid fa-circle-check fs-5"></i>
    <div>
      <% if (success === 'created') { %>Đã đăng tin tuyển dụng mới thành công!<% } %>
      <% if (success === 'saved') { %>Đã lưu thông tin tuyển dụng!<% } %>
      <% if (success === 'deleted') { %>Đã xóa tin tuyển dụng thành công!<% } %>
    </div>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h3 class="admin-card-title"><i class="fa-solid fa-briefcase text-primary me-2"></i>Quản Lý Vị Trí Tuyển Dụng</h3>
      <small class="text-muted">Đăng tin tuyển dụng nhân tài, cập nhật mức lương, địa điểm và thời hạn nộp hồ sơ.</small>
    </div>
    <a href="/admin/jobs/new" class="btn btn-primary btn-sm">
      <i class="fa-solid fa-plus me-1"></i>Đăng Tuyển Dụng Mới
    </a>
  </div>
  <div class="admin-card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table align-middle">
        <thead>
          <tr>
            <th>Chức Danh Tuyển Dụng</th>
            <th>Phòng Ban</th>
            <th>Địa Điểm</th>
            <th>Mức Lương</th>
            <th>Hạn Nộp</th>
            <th>Trạng Thái</th>
            <th style="width: 140px;" class="text-end">Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% if (jobs && jobs.length) { %>
            <% jobs.forEach(function(j) { %>
              <tr>
                <td>
                  <div class="fw-bold text-dark"><%= j.title %></div>
                  <div class="small text-muted"><%= j.experience %> | <%= j.type %></div>
                </td>
                <td><span class="badge bg-light text-primary border"><%= j.department %></span></td>
                <td><small class="text-secondary"><%= j.location %></small></td>
                <td><span class="fw-bold text-success"><%= j.salary %></span></td>
                <td><small class="text-danger"><%= j.deadline || 'Thường xuyên' %></small></td>
                <td>
                  <% if (j.active !== false) { %>
                    <span class="badge bg-success-subtle text-success">Đang tuyển</span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">Đã đóng</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/admin/jobs/edit/<%= j.id %>" class="btn btn-outline-primary" title="Sửa">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <form action="/admin/jobs/delete/<%= j.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa tin tuyển dụng này?');">
                      <button type="submit" class="btn btn-outline-danger" title="Xóa">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">Chưa có vị trí tuyển dụng nào.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/admin-footer') %>

